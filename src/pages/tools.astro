---
import Base from '../layouts/Base.astro';
import { SITE, TOOLS, GUIDES } from '../data/site';

const title = 'All HOYO WISH Tools – Pity, Tracking, Planning';
const description =
  'Every HOYO WISH tool in one place: pity calculator, browser-only wish tracker, primogem planner and 50/50 stats — for Genshin, Star Rail and ZZZ.';
---

<Base title={title} description={description} crumbs={[{ name: 'Tools' }]}>
  <div class="page-head">
    <h1>All wish tools</h1>
    <div class="h1-bar"></div>
    <p class="lede">Four tools covering the pull loop: plan it, log it, judge your luck. All free, all client-side.</p>
  </div>

  <div class="cards">
    {TOOLS.map((t) => (
      <a class="card" href={t.href}>
        <span class="ico">{t.ico}</span>
        <h3>{t.name}</h3>
        <p>{t.desc}</p>
        <span class="tag">{t.tag}</span>
      </a>
    ))}
  </div>

  <section class="prose">
    <h2>Guides that feed the tools</h2>
    <ul>
      {GUIDES.map((g) => <li><a href={g.href}>{g.name}</a> — {g.desc}</li>)}
    </ul>
  </section>
</Base>
